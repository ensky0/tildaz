+pub var temp763_wake_sent = std.atomic.Value(u32).init(0);
+pub var temp763_wake_skipped = std.atomic.Value(u32).init(0);
+pub fn temp763PendingInput() u64 {
+    return pending_input_ns.load(.acquire);
+}
+pub fn temp763ParsedEcho() u64 {
+    return echo_parsed_ns.load(.acquire);
+}
+/// TEMP #763 2 차 — 건너뜀 중 첫 키 **전**의 몫 · present 한 번마다의 시간 · 에코 프레임의 분해.
+pub var temp763_seen_key = std.atomic.Value(bool).init(false);
+pub var temp763_wake_skipped_prekey = std.atomic.Value(u32).init(0);
+pub var temp763_present: Counter = .{};
+pub var temp763_present_hist: Histogram = .{};
+/// 에코를 그린 프레임만 — 키 → present 시작 · present 호출.
+pub var temp763_echo_pre: Counter = .{};
+pub var temp763_echo_pre_hist: Histogram = .{};
+pub var temp763_echo_pres: Counter = .{};
+pub var temp763_echo_pres_hist: Histogram = .{};
+/// `Present` 직후, `completeEcho` 가 `echo_parsed_ns` 를 비우기 **전에** 부른다.
+pub fn temp763NotePresent(t0: Timestamp) void {
+    const start = t0 orelse return;
+    const t = now() orelse return;
+    if (t <= start) return;
+    recordLatency(&temp763_present, &temp763_present_hist, t - start);
+    const key = echo_parsed_ns.load(.acquire);
+    if (key == 0 or start <= key) return;
+    recordLatency(&temp763_echo_pre, &temp763_echo_pre_hist, start - key);
+    recordLatency(&temp763_echo_pres, &temp763_echo_pres_hist, t - start);
+}
