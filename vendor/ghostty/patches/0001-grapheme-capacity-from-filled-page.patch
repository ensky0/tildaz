+/// TildaZ #812: the grapheme bytes a new page of `std_cap` needs at the
+/// density of `last`, the page that just filled up. Zero when `last` used
+/// no grapheme memory or has a different width.
+fn carriedGraphemeNeed(last: *const Page, std_cap: Capacity) usize {
+    if (last.capacity.cols != std_cap.cols) return 0;
+    if (last.size.rows == 0) return 0;
+    const used = last.grapheme_alloc.usedBytes(last.memory);
+    if (used == 0) return 0;
+    return used * std_cap.rows / last.size.rows;
+}
+
+/// TildaZ #812: `std_cap` with room for `need` grapheme bytes plus the same
+/// 25% headroom `increaseCapacity` projects with. Falls back to `std_cap`
+/// when the result would not fit a page.
+fn capacityWithGrapheme(std_cap: Capacity, need: usize) Capacity {
+    const want = need + need / 4;
+    if (want <= std_cap.grapheme_bytes) return std_cap;
+    const Int = @FieldType(Capacity, "grapheme_bytes");
+    var cap = std_cap;
+    cap.grapheme_bytes = @intCast(@min(want, std.math.maxInt(Int)));
+    if (Page.layout(cap).total_size > size.max_page_size) return std_cap;
+    return cap;
+}
