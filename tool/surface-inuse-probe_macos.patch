+// TEMP #769 진단 — 표시 대상 고르기 결과. 커밋하지 않는다.
+const Temp769 = struct {
+    /// 0 = 다시 씀 · 1 = 새로 만듦 · 2 = 미룸.
+    outcome: [3]std.atomic.Value(u64) = @splat(std.atomic.Value(u64).init(0)),
+    skip_held: std.atomic.Value(u64) = std.atomic.Value(u64).init(0),
+    picked_held: std.atomic.Value(u64) = std.atomic.Value(u64).init(0),
+    slots_max: std.atomic.Value(u64) = std.atomic.Value(u64).init(0),
+};
+var temp769: Temp769 = .{};
+
+pub fn temp769Record(outcome: usize, skip: u32, picked_held: bool, slots: u32) void {
+    _ = temp769.outcome[outcome].fetchAdd(1, .monotonic);
+    _ = temp769.skip_held.fetchAdd(skip, .monotonic);
+    if (picked_held) _ = temp769.picked_held.fetchAdd(1, .monotonic);
+    _ = temp769.slots_max.fetchMax(slots, .monotonic);
 }
 
