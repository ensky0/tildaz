+test "PageList heapPageFits (TildaZ #812 · #841)" {
+    const testing = std.testing;
+    const cap: Capacity = .{ .cols = 80, .rows = 100, .grapheme_bytes = 16384 };
+
+    // The same capacity, or larger by up to twice in each dimension.
+    try testing.expect(heapPageFits(cap, cap));
+    var big = cap;
+    big.grapheme_bytes = 32768;
+    big.rows = 200;
+    try testing.expect(heapPageFits(big, cap));
+
+    // Too small in any dimension, or more than twice as large.
+    var small = cap;
+    small.grapheme_bytes = 16383;
+    try testing.expect(!heapPageFits(small, cap));
+    small = cap;
+    small.rows = 99;
+    try testing.expect(!heapPageFits(small, cap));
+    var huge = cap;
+    huge.grapheme_bytes = 32769;
+    try testing.expect(!heapPageFits(huge, cap));
+    huge = cap;
+    huge.styles = cap.styles * 2 + 1;
+    try testing.expect(!heapPageFits(huge, cap));
+
+    // A different column count never fits.
+    var narrow = cap;
+    narrow.cols = 79;
+    try testing.expect(!heapPageFits(narrow, cap));
 }
 
+test "PageList grow reuses pruned heap pages for grapheme-heavy output (TildaZ #812 · #841)" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var s = try init(alloc, .{ .cols = 80, .rows = 24, .max_size = null });
+    defer s.deinit();
+
+    // Fill the last page with a grapheme in every cell, as emoji output
+    // with a variation selector does, growing the page the way Screen does
+    // when it runs out. That is far more than a standard page holds, so
+    // the page can't be trimmed to fit a pool item. Stops after starting
+    // the next page.
+    const Fill = struct {
+        fn run(list: *PageList) !void {
+            while (true) {
+                for (0..80) |x| {
+                    while (true) {
+                        const node = list.pages.last.?;
+                        const page = node.page();
+                        const rac = page.getRowAndCell(x, node.rows() - 1);
+                        rac.cell.* = .{
+                            .content_tag = .codepoint,
+                            .content = .{ .codepoint = .{ .data = 'e' } },
+                        };
+                        page.appendGrapheme(rac.row, rac.cell, 0x0301) catch |err| switch (err) {
+                            error.OutOfMemory => {
+                                _ = try list.increaseCapacity(node, .grapheme_bytes);
+                                continue;
+                            },
+                        };
+                        break;
+                    }
+                }
+                if (try list.grow() != null) return;
+            }
+        }
+    };
+
+    // Two pages carry the grapheme capacity, so the third is born on the
+    // heap with it.
+    try Fill.run(&s);
+    try Fill.run(&s);
+    try testing.expectEqual(.heap, s.pages.last.?.owned);
+    const heap_len = s.pages.last.?.page().memory.len;
+    try testing.expect(heap_len > std_size);
+
+    // Cap the scrollback at a few such pages so that every new page
+    // prunes the first one.
+    s.limits.set(.bytes, s.page_size + 2 * heap_len);
+    for (0..12) |_| {
+        try Fill.run(&s);
+        try s.verifyIntegrity();
+        try testing.expect(s.page_size <= s.limits.max(.bytes) + heap_len);
+    }
+
+    // The scrollback now cycles through heap pages of one size.
+    var it = s.pages.first;
+    var heap_pages: usize = 0;
+    while (it) |node| : (it = node.next) {
+        if (node.owned == .heap) {
+            heap_pages += 1;
+            try testing.expectEqual(heap_len, node.page().memory.len);
+        }
+    }
+    try testing.expect(heap_pages >= 2);
+}
