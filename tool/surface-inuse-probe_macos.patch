+    const t769 = std.fmt.bufPrint(
+        buf[text.len + tail.len ..],
+        "T769     acq v={d} w={d} old_held v={d} w={d} mid_held v={d} w={d} shown_held v={d} w={d} old_held_mid_free={d} new_slot={d}\n" ++
+            "T769dt   held={any} free={any}\n",
+        .{
+            t7.acq[0].swap(0, .monotonic),
+            t7.acq[1].swap(0, .monotonic),
+            t7.old_held[0].swap(0, .monotonic),
+            t7.old_held[1].swap(0, .monotonic),
+            t7.mid_held[0].swap(0, .monotonic),
+            t7.mid_held[1].swap(0, .monotonic),
+            t7.shown_held[0].swap(0, .monotonic),
+            t7.shown_held[1].swap(0, .monotonic),
+            t7.old_held_mid_free.swap(0, .monotonic),
+            t7.new_slot.swap(0, .monotonic),
+            t7.dt_held.take(),
+            t7.dt_free.take(),
+        },
+    ) catch return;
+
+    log.appendBlock(buf[0 .. text.len + tail.len + t769.len]);
+}
+
+// TEMP #769 진단 — 그릴 장을 고를 때 세 장이 창 서버에 잡혀 있는가. 커밋하지 않는다.
+// 배열 인덱스 0 = vsync tick (`displayLinkFire`), 1 = 출력 통보 (`outputWakePerform`).
+const Temp769 = struct {
+    acq: [2]std.atomic.Value(u64) = @splat(std.atomic.Value(u64).init(0)),
+    old_held: [2]std.atomic.Value(u64) = @splat(std.atomic.Value(u64).init(0)),
+    mid_held: [2]std.atomic.Value(u64) = @splat(std.atomic.Value(u64).init(0)),
+    shown_held: [2]std.atomic.Value(u64) = @splat(std.atomic.Value(u64).init(0)),
+    old_held_mid_free: std.atomic.Value(u64) = std.atomic.Value(u64).init(0),
+    new_slot: std.atomic.Value(u64) = std.atomic.Value(u64).init(0),
+    /// 가장 오래된 장이 화면에서 내려온 뒤 지난 시간 — 잡혀 있었을 때 / 비어 있었을 때.
+    dt_held: Histogram = .{},
+    dt_free: Histogram = .{},
+};
+var temp769: Temp769 = .{};
+
+pub fn temp769Record(from_wake: bool, old_held: ?bool, mid_held: bool, shown_held: bool, dt_old_ns: ?u64) void {
+    const s: usize = @intFromBool(from_wake);
+    _ = temp769.acq[s].fetchAdd(1, .monotonic);
+    if (mid_held) _ = temp769.mid_held[s].fetchAdd(1, .monotonic);
+    if (shown_held) _ = temp769.shown_held[s].fetchAdd(1, .monotonic);
+    const o = old_held orelse {
+        _ = temp769.new_slot.fetchAdd(1, .monotonic);
+        return;
+    };
+    if (o) {
+        _ = temp769.old_held[s].fetchAdd(1, .monotonic);
+        if (!mid_held) _ = temp769.old_held_mid_free.fetchAdd(1, .monotonic);
+    }
+    if (dt_old_ns) |dt| {
+        if (o) temp769.dt_held.add(dt) else temp769.dt_free.add(dt);
+    }
 }
 
