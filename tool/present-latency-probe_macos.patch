+// TEMP #476 진단 — macOS `nextDrawable` 대기 · 프레임 안의 드레인. 원인 확정 뒤 걷는다.
+pub var temp_drawable_wait: Counter = .{};
+pub var temp_drawable_wait_hist: Histogram = .{};
+pub var temp_frame_drain: Counter = .{};
+pub var temp_frame_drain_hist: Histogram = .{};
+pub fn tempAddDrawableWait(start: Timestamp) void {
+    const dt = nsSince(start) orelse return;
+    recordLatency(&temp_drawable_wait, &temp_drawable_wait_hist, dt);
+}
+// TEMP #476 — present → 화면 표시 (`presentedTime` − present 시각). 0 이면 표시되지 못한 프레임.
+pub var temp_present_lat: Counter = .{};
+pub var temp_present_lat_hist: Histogram = .{};
+pub var temp_present_drop: Counter = .{};
+pub fn tempAddPresentLatency(presented_s: f64, present_call_s: f64) void {
+    if (presented_s <= 0 or present_call_s <= 0) {
+        _ = temp_present_drop.calls.fetchAdd(1, .monotonic);
+        return;
+    }
+    const d = presented_s - present_call_s;
+    if (d < 0) return;
+    recordLatency(&temp_present_lat, &temp_present_lat_hist, @intFromFloat(d * 1e9));
+}
+pub fn tempAddFrameDrain(start: Timestamp) void {
+    const dt = nsSince(start) orelse return;
+    recordLatency(&temp_frame_drain, &temp_frame_drain_hist, dt);
+}
