+test "PageList grow sizes the next page's graphemes from the filled page (TildaZ #812)" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var s = try init(alloc, .{ .cols = 80, .rows = 24, .max_size = null });
+    defer s.deinit();
+
+    const std_graphemes = initialCapacity(80).grapheme_bytes;
+
+    // Use 600 one-chunk graphemes (9600 bytes), more than a standard page
+    // holds, growing the page the way Screen does when it runs out.
+    for (0..600) |i| {
+        while (true) {
+            const page = s.pages.first.?.page();
+            const rac = page.getRowAndCell(i % 80, i / 80);
+            rac.cell.* = .{
+                .content_tag = .codepoint,
+                .content = .{ .codepoint = .{ .data = 'e' } },
+            };
+            page.appendGrapheme(rac.row, rac.cell, 0x0301) catch |err| switch (err) {
+                error.OutOfMemory => {
+                    _ = try s.increaseCapacity(s.pages.first.?, .grapheme_bytes);
+                    continue;
+                },
+            };
+            break;
+        }
+    }
+    const used = s.pages.first.?.page().grapheme_alloc.usedBytes(s.pages.first.?.page().memory);
+    try testing.expect(used > std_graphemes);
+
+    // Fill the first page and start the next one.
+    while (s.pages.last.?.rows() < s.pages.last.?.capacity().rows) _ = try s.grow();
+    _ = try s.grow();
+    try testing.expect(s.pages.first != s.pages.last);
+
+    // The new page starts with the filled page's need plus 25% headroom
+    // instead of the standard default.
+    try testing.expect(s.pages.last.?.capacity().grapheme_bytes >= used + used / 4);
+
+    // A page without graphemes sends the next page back to the default.
+    while (s.pages.last.?.rows() < s.pages.last.?.capacity().rows) _ = try s.grow();
+    _ = try s.grow();
+    try testing.expectEqual(std_graphemes, s.pages.last.?.capacity().grapheme_bytes);
+}
