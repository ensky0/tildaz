// tildaz PE VERSIONINFO resource template.
//
// Version values are generated from build.zig.zon by build/version.zig.
// winver.h / winres.h 를 include 하지 않도록 VS_VERSION_INFO = 1 을 직접 사용하고,
// FILEOS / FILETYPE 상수도 리터럴로 박는다. llvm-rc + Zig 크로스 빌드 호환.

#pragma code_page(65001)

// 앱 아이콘 (#145). docs/favicon.svg 에서 sips 로 PNG 6 size (16/32/48/64/128/256)
// 만든 후 Python 으로 multi-resolution ICO 로 묶음. Windows Explorer 가 가장
// 작은 ID 를 default 로 채택하므로 IDI_ICON 1 로 등록. generated RC는 build.zig가
// src/를 llvm-rc include path로 전달해 이 파일을 찾는다.
1 ICON "tildaz.ico"

1 VERSIONINFO
 FILEVERSION    @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@VERSION_REVISION@
 PRODUCTVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@VERSION_REVISION@
 FILEFLAGSMASK  0x3FL
 FILEFLAGS      @WINDOWS_FILE_FLAGS@L
 FILEOS         0x00040004L   // VOS_NT_WINDOWS32
 FILETYPE       0x00000001L   // VFT_APP
 FILESUBTYPE    0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"  // U.S. English (0x0409), Unicode (1200 = 0x04b0)
        BEGIN
            VALUE "CompanyName",      "ensky0"
            VALUE "FileDescription",  "TildaZ - drop-down terminal for Linux, macOS, and Windows"
            VALUE "FileVersion",      "@VERSION_FULL@"
            VALUE "InternalName",     "tildaz"
            VALUE "LegalCopyright",   "(c) 2026 ensky0. AGPL-3.0-or-later."
            VALUE "OriginalFilename", "tildaz.exe"
            VALUE "ProductName",      "TildaZ"
            VALUE "ProductVersion",   "@VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
