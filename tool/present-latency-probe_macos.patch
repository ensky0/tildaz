+// TEMP #476 — present → 화면 표시 지연. present 시각을 drawableID 칸에 적고, 표시 handler 가 읽는다.
+extern "QuartzCore" fn CACurrentMediaTime() f64;
+var temp_present_t: [64]std.atomic.Value(u64) = @splat(std.atomic.Value(u64).init(0));
+fn tempPresentedInvoke(_: *PresentedBlock, drawable: objc.id) callconv(.c) void {
+    if (drawable == null) return;
+    const presentedTimeOf = objc.objcSend(fn (objc.id, objc.SEL) callconv(.c) f64);
+    const idOf = objc.objcSend(fn (objc.id, objc.SEL) callconv(.c) c_ulong);
+    const pt = presentedTimeOf(drawable, objc.sel("presentedTime"));
+    const id = idOf(drawable, objc.sel("drawableID"));
+    const t0: f64 = @bitCast(temp_present_t[id % 64].load(.acquire));
+    perf.tempAddPresentLatency(pt, t0);
+}
+var temp_presented_block: PresentedBlock = .{
+    .isa = null,
+    .flags = BLOCK_IS_GLOBAL,
+    .reserved = 0,
+    .invoke = &tempPresentedInvoke,
+    .descriptor = &presented_block_descriptor,
+};
+
