 ///
 /// This doesn't change the PageList. `grow` stores the returned `need`
 /// in `grow_hints` once the new page exists.
+/// The end of a grow that reused the pruned first page (TildaZ #812 ·
+/// #841): `first` already holds its new, zeroed layout.
+fn growReuseFinish(
+    self: *PageList,
+    first: *List.Node,
+    last: *List.Node,
+    grow_cap: GrowCapacity,
+) *List.Node {
+    const page = first.page();
+    page.size.rows = 1;
+    self.pages.insertAfter(last, first);
+    self.total_rows += 1;
+    self.pushGrowHint(grow_cap.need, grow_cap.used);
+
+    // Reusing the node gives it a fresh generation. Do not begin a new
+    // page_serial_epoch here: generations are not monotonic in list order,
+    // so older live successors may have lower generations. The epoch only
+    // advances when reset invalidates the entire list.
+    first.serial = self.page_serial;
+    self.page_serial += 1;
+
+    // We don't update page_size. A pool-owned page always counts as
+    // one pool item, whatever its layout, and a reused heap page keeps
+    // its memory and so its length.
+
+    page.assertIntegrity();
+
+    // An earlier grow may have left us over the byte limit, because
+    // pruning would have cut into the active area (see the trimming
+    // costs in growCapacity). Reuse swaps one page for another of the
+    // same size, so it can't fix that on its own. Enforce the limit here.
+    self.limits.enforce(self, .bytes);
+
+    // Byte-limit recycling may leave history above the independent line
+    // limit, so enforce it after the recycled page becomes the new tail.
+    self.limits.enforce(self, .lines);
+    return first;
+}
+
+/// Whether a pruned heap page with capacity `fc` can be reused for a grow
+/// that wants capacity `cap` (TildaZ #812 · #841). The page keeps `fc`, so
+/// it must hold what `cap` asks for. It must not be much larger, or one
+/// old outsized page would stay alive forever: each dimension `cap`
+/// grows may be at most twice what it asks for, and the others must be
+/// the standard size `cap` already has.
+fn heapPageFits(fc: Capacity, cap: Capacity) bool {
+    if (fc.cols != cap.cols) return false;
+    if (fc.rows < cap.rows or fc.rows > cap.rows * 2) return false;
+    inline for (.{
+        "styles",
+        "grapheme_bytes",
+        "string_bytes",
+        "hyperlink_bytes",
+        "hyperlink_cells",
+    }) |f| {
+        const want: usize = @field(cap, f);
+        const have: usize = @field(fc, f);
+        if (have < want or have > want * 2) return false;
+    }
+    return true;
+}
